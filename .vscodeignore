# Development files
.vscode/**
.vscode-test/**
src/**
out/test/**
_vsix_check/**
_vsix.zip
scripts/**
!scripts/smoke-secure-endpoint.js

# Config files
.gitignore
.yarnrc
**/tsconfig.json
**/.eslintrc.json

# Build artifacts — only ship bundled extension entry + plugin worker
**/*.map
**/*.ts
dist/**
!dist/extension.js
!dist/plugin-worker.js
# Tree-sitter runtime + Python/Java grammars (syntax precision layer)
!dist/wasm/**

# Dependencies are bundled
node_modules/**
vendor/**
packages/**

# Docs noise
.github/**
docs/**
!README.md
!CHANGELOG.md
!LICENSE*

# Test / package junk
**/*.test.ts
**/*.spec.ts
coverage/**
*.vsix
package-lock.json
pnpm-lock.yaml
