{
  "id": "jokalala.secrets",
  "name": "Jokalala Secrets Pack",
  "version": "1.1.0",
  "description": "High-confidence hardcoded secret patterns (P3a seed pack)",
  "author": "Jokalala",
  "license": "MIT",
  "rules": [
    {
      "id": "aws-access-key-id",
      "cweId": "CWE-798",
      "name": "Hardcoded AWS Access Key ID",
      "category": "data_exposure",
      "severity": "critical",
      "languages": [
        "javascript",
        "typescript",
        "python",
        "java",
        "*"
      ],
      "patterns": [
        {
          "type": "regex",
          "value": "AKIA[0-9A-Z]{16}",
          "flags": "g"
        }
      ],
      "message": "Possible hardcoded AWS Access Key ID",
      "recommendation": "Store secrets in a vault or environment variables; rotate if exposed"
    },
    {
      "id": "generic-api-key-assignment",
      "cweId": "CWE-798",
      "name": "Hardcoded API key assignment",
      "category": "data_exposure",
      "severity": "high",
      "languages": [
        "javascript",
        "typescript"
      ],
      "patterns": [
        {
          "type": "regex",
          "value": "(?:api[_-]?key|secret[_-]?key|access[_-]?token)\\s*[:=]\\s*['\"][A-Za-z0-9_\\-]{20,}['\"]",
          "flags": "gi"
        }
      ],
      "message": "Possible hardcoded API key or token in source",
      "recommendation": "Move secrets to environment configuration; never commit credentials"
    },
    {
      "id": "github-token",
      "cweId": "CWE-798",
      "name": "Hardcoded GitHub token",
      "category": "data_exposure",
      "severity": "critical",
      "languages": [
        "*"
      ],
      "patterns": [
        {
          "type": "regex",
          "value": "gh[pousr]_[A-Za-z0-9]{36,}",
          "flags": "g"
        }
      ],
      "message": "Possible hardcoded GitHub token",
      "recommendation": "Revoke the token and move it to a secrets manager",
      "owaspCategory": "A02:2021 - Cryptographic Failures"
    },
    {
      "id": "slack-token",
      "cweId": "CWE-798",
      "name": "Hardcoded Slack token",
      "category": "data_exposure",
      "severity": "critical",
      "languages": [
        "*"
      ],
      "patterns": [
        {
          "type": "regex",
          "value": "xox[baprs]-[A-Za-z0-9][A-Za-z0-9-]{10,}",
          "flags": "g"
        }
      ],
      "message": "Possible hardcoded Slack token",
      "recommendation": "Revoke the token and move it to a secrets manager",
      "owaspCategory": "A02:2021 - Cryptographic Failures"
    },
    {
      "id": "stripe-secret-key",
      "cweId": "CWE-798",
      "name": "Hardcoded Stripe live secret key",
      "category": "data_exposure",
      "severity": "critical",
      "languages": [
        "*"
      ],
      "patterns": [
        {
          "type": "regex",
          "value": "sk_live_[A-Za-z0-9]{16,}",
          "flags": "g"
        }
      ],
      "message": "Possible hardcoded Stripe live secret key",
      "recommendation": "Revoke the key and move it to a secrets manager",
      "owaspCategory": "A02:2021 - Cryptographic Failures"
    },
    {
      "id": "google-api-key",
      "cweId": "CWE-798",
      "name": "Hardcoded Google API key",
      "category": "data_exposure",
      "severity": "high",
      "languages": [
        "*"
      ],
      "patterns": [
        {
          "type": "regex",
          "value": "AIza[0-9A-Za-z_\\-]{35}",
          "flags": "g"
        }
      ],
      "message": "Possible hardcoded Google API key",
      "recommendation": "Restrict and rotate the key; load it from configuration",
      "owaspCategory": "A02:2021 - Cryptographic Failures"
    },
    {
      "id": "private-key-block",
      "cweId": "CWE-798",
      "name": "Private key material in source",
      "category": "data_exposure",
      "severity": "critical",
      "languages": [
        "*"
      ],
      "patterns": [
        {
          "type": "regex",
          "value": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY(?: BLOCK)?-----",
          "flags": "g"
        }
      ],
      "message": "Private key material committed to source",
      "recommendation": "Remove the key, rotate it, and store keys outside the repo",
      "owaspCategory": "A02:2021 - Cryptographic Failures"
    },
    {
      "id": "aws-secret-access-key",
      "cweId": "CWE-798",
      "name": "Hardcoded AWS secret access key",
      "category": "data_exposure",
      "severity": "critical",
      "languages": [
        "*"
      ],
      "patterns": [
        {
          "type": "regex",
          "value": "(?:aws)[^\\n]{0,20}(?:secret)[^\\n]{0,20}['\\\"][A-Za-z0-9/+=]{40}['\\\"]",
          "flags": "gi"
        },
        {
          "type": "pattern-not",
          "pattern": {
            "type": "regex",
            "value": "EXAMPLE|examplekey",
            "flags": "gi"
          }
        }
      ],
      "message": "Possible hardcoded AWS secret access key",
      "recommendation": "Rotate the key and use IAM roles or a secrets manager",
      "owaspCategory": "A02:2021 - Cryptographic Failures"
    },
    {
      "id": "jwt-in-source",
      "cweId": "CWE-798",
      "name": "Hardcoded JWT",
      "category": "data_exposure",
      "severity": "high",
      "languages": [
        "*"
      ],
      "patterns": [
        {
          "type": "regex",
          "value": "eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{5,}",
          "flags": "g"
        }
      ],
      "message": "Possible hardcoded JSON Web Token",
      "recommendation": "Do not commit tokens; issue them at runtime",
      "owaspCategory": "A02:2021 - Cryptographic Failures"
    },
    {
      "id": "connection-string-credentials",
      "cweId": "CWE-798",
      "name": "Credentials embedded in a connection URI",
      "category": "data_exposure",
      "severity": "critical",
      "languages": [
        "*"
      ],
      "patterns": [
        {
          "type": "regex",
          "value": "(?:mongodb(?:\\+srv)?|postgres(?:ql)?|mysql|redis|amqps?)://[^\\s'\\\"@/]+:[^\\s'\\\"@]+@",
          "flags": "g"
        }
      ],
      "message": "Connection string embeds a username and password",
      "recommendation": "Load credentials from environment/secrets manager, not source",
      "owaspCategory": "A02:2021 - Cryptographic Failures"
    },
    {
      "id": "npm-token",
      "cweId": "CWE-798",
      "name": "Hardcoded npm token",
      "category": "data_exposure",
      "severity": "high",
      "languages": [
        "*"
      ],
      "patterns": [
        {
          "type": "regex",
          "value": "npm_[A-Za-z0-9]{36}",
          "flags": "g"
        }
      ],
      "message": "Possible hardcoded npm automation token",
      "recommendation": "Revoke the token and use CI secret storage",
      "owaspCategory": "A02:2021 - Cryptographic Failures"
    },
    {
      "id": "slack-webhook-url",
      "cweId": "CWE-798",
      "name": "Hardcoded Slack webhook URL",
      "category": "data_exposure",
      "severity": "medium",
      "languages": [
        "*"
      ],
      "patterns": [
        {
          "type": "regex",
          "value": "hooks\\.slack\\.com/services/T[A-Za-z0-9_/]{8,}",
          "flags": "g"
        }
      ],
      "message": "Slack webhook URLs grant posting access to anyone who has them",
      "recommendation": "Store webhook URLs in configuration, not source",
      "owaspCategory": "A02:2021 - Cryptographic Failures"
    }
  ]
}
